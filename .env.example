# Copy this file to .env and fill in real values. .env is gitignored.

# WhatsApp side (existing)
HEALTHCHECK_URL=

# Telegram side (new for sprint 2)
# Get a token from @BotFather on Telegram. Disable privacy mode so the bot
# can read group messages: @BotFather → /mybots → your bot → Bot Settings → Group Privacy → Turn OFF.
TELEGRAM_BOT_TOKEN=
HEALTHCHECK_URL_TG=

# Sprint 3 — NLP split wizard
# Get an API key from https://platform.deepseek.com
DEEPSEEK_API_KEY=
